{
  "name": "formweave",
  "version": "0.2.0",
  "description": "Forms as JSON: a visual builder, a React renderer and web components, scanning paper forms on the device, and one engine for validation, conditions and formulas that runs in the browser and on your server.",
  "keywords": [
    "form",
    "form-builder",
    "forms",
    "json-schema",
    "react",
    "web-components",
    "validation",
    "formulas",
    "drag-and-drop",
    "ocr",
    "pdf",
    "survey"
  ],
  "license": "MIT",
  "author": "Harendra Singh Negi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harendra-singh-negi/formweave.git"
  },
  "homepage": "https://harendra-singh-negi.github.io/formweave/",
  "bugs": {
    "url": "https://github.com/harendra-singh-negi/formweave/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./style.css": "./dist/style.css",
    "./builder": {
      "types": "./dist/builder.d.ts",
      "default": "./dist/builder.js"
    },
    "./scan": {
      "types": "./dist/scan.d.ts",
      "default": "./dist/scan.js"
    },
    "./samples": {
      "types": "./dist/samples.d.ts",
      "default": "./dist/samples.js"
    },
    "./builder.css": "./dist/builder.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/element.js",
    "./src/element.ts",
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "demo": "vite --open",
    "demo:build": "vite build",
    "demo:gif": "node scripts/record-demo.mjs",
    "dev": "vite",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "test:e2e": "playwright test",
    "test:dist": "node scripts/smoke.mjs",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.94.0",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=5",
    "react": ">=18",
    "react-dom": ">=18",
    "tesseract.js": ">=6"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tesseract.js": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    }
  }
}
