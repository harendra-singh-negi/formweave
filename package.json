{
  "name": "formweave",
  "version": "0.0.0",
  "private": true,
  "description": "Forms as JSON: one engine for validation, conditions and formulas that runs in the browser and on your server.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./style.css": "./dist/style.css",
    "./builder": {
      "types": "./dist/builder.d.ts",
      "default": "./dist/builder.js"
    },
    "./scan": {
      "types": "./dist/scan.d.ts",
      "default": "./dist/scan.js"
    },
    "./samples": {
      "types": "./dist/samples.d.ts",
      "default": "./dist/samples.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/element.js",
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/style.css dist/",
    "typecheck": "tsc",
    "test": "node --experimental-strip-types --no-warnings --test src/*.test.ts",
    "demo": "vite --open",
    "dev": "vite"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=5",
    "react": ">=18",
    "react-dom": ">=18",
    "tesseract.js": ">=6"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tesseract.js": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    }
  }
}
